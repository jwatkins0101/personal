      "rules": [
        {
          "name": "failed payment or billing problem",
          "subject": "(payment|charge|invoice).{0,30}(failed|declined|past due|overdue|unsuccessful)|card (was )?declined|action required.{0,20}(payment|billing)",
          "action": "keep_star"
        },
        {
          "name": "security alert",
          "subject": "security alert|new sign-in|suspicious|verify your (identity|account)|password (was )?changed|2-step|unusual activity",
          "action": "keep"
        },
