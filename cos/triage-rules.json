{
  "_doc": "Rules-based triage for the non-personal mailboxes (D24). First matching rule wins. Actions: keep (stay in inbox), keep_star (stay + star), archive (remove from inbox, add the rule's label). Anything no rule matches STAYS in the inbox. Starred mail and senders you've written to in the last 90 days always stay. Built from the 2026-09-25 mailbox analysis.",
  "accounts": {
    "owlthat": {
      "labels": {
        "ci": "CoS/CI",
        "newsletters": "CoS/Newsletters",
        "notifications": "CoS/Notifications"
      },
      "rules": [
        {
          "name": "billing problem (failed payment, balance due, collections)",
          "subject": "(payment|charge|invoice).{0,30}(failed|declined|past due|overdue|unsuccessful)|card (was )?declined|collections?\\b|past due|overdue|delinquen|final notice|limit reached|pay your balance|balance (is )?(due|overdue)|action required.{0,20}(payment|billing)|suspend",
          "action": "keep_star"
        },
        {
          "name": "security alert",
          "subject": "security (alert|risk|issue|notice)|new sign-in|suspicious|verify your (identity|account)|password.{0,40}(changed|reset)|2-step|unusual activity|compromised|unauthori[sz]ed",
          "action": "keep"
        },
        {
          "name": "infrastructure health (AWS Health, action needed)",
          "from": [
            "health@aws.com"
          ],
          "action": "keep"
        },
        {
          "name": "infrastructure action required",
          "subject": "action required|retirement|scheduled maintenance|deprecat|end of (life|support)",
          "from_domain": [
            "aws.com",
            "amazonaws.com",
            "google.com",
            "atlassian.net",
            "github.com"
          ],
          "action": "keep"
        },
        {
          "name": "legal, registered agent, tax",
          "from_domain": [
            "cscglobal.com",
            "irs.gov",
            "sos.ky.gov",
            "delaware.gov"
          ],
          "action": "keep"
        },
        {
          "name": "app and marketplace reviews",
          "from_domain": [
            "canva.com"
          ],
          "subject": "review|approved|rejected|submission|APPS-\\d+",
          "action": "keep"
        },
        {
          "name": "CI build alerts",
          "from": [
            "website@owlthat.com"
          ],
          "subject": "^\\[owlthat ci\\]",
          "action": "archive",
          "label": "ci"
        },
        {
          "name": "newsletters",
          "from_domain": [
            "pitchbook.com",
            "beehiiv.com",
            "substack.com",
            "hubspot.com",
            "mail.beehiiv.com"
          ],
          "action": "archive",
          "label": "newsletters"
        },
        {
          "name": "vendor marketing (has unsubscribe link)",
          "from_domain": [
            "openai.com",
            "tiktok.com",
            "google.com",
            "canva.com",
            "stripe.com",
            "atlassian.net",
            "aws.com",
            "brex.com"
          ],
          "bulk": true,
          "action": "archive",
          "label": "newsletters"
        },
        {
          "name": "service notifications",
          "from_domain": [
            "brex.com",
            "stripe.com",
            "aws.com",
            "amazonaws.com",
            "atlassian.net",
            "atlassian.com",
            "google.com",
            "tiktok.com",
            "github.com"
          ],
          "action": "archive",
          "label": "notifications"
        },
        {
          "name": "any other bulk mail",
          "bulk": true,
          "action": "archive",
          "label": "newsletters"
        }
      ],
      "backlog": {
        "older_than_days": 0,
        "include_unread": true
      }
    },
    "techunify": {
